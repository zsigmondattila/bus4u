# is commented out by default.
.vscode/settings.json

# Flutter/Dart/Pub related
APPLICATION/**/doc/api/
APPLICATION/**/ios/Flutter/.last_build_id
APPLICATION/.dart_tool/
APPLICATION/.flutter-plugins
APPLICATION/.flutter-plugins-dependencies
APPLICATION/.packages
APPLICATION/.pub-cache/
APPLICATION/.pub/
APPLICATION/build/

# Symbolication related
APPLICATION/app.*.symbols

# Obfuscation related
APPLICATION/app.*.map.json

# Android Studio will place build artifacts here
APPLICATION/android/app/debug
APPLICATION/android/app/profile
APPLICATION/android/app/release

API/.bundle
API/db/*.sqlite3
API/db/*.sqlite3-*

API/log/*
API/tmp/*
!API/log/.keep
!API/tmp/.keep

API/tmp/pids/*

